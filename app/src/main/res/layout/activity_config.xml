<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="Anteprima del widget"
            android:scaleType="fitCenter" />

        <TextView
            style="@style/Label"
            android:text="Titolo" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="40" />

        <TextView
            style="@style/Label"
            android:text="Data dell'evento" />

        <Button
            android:id="@+id/btnDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="false" />

        <TextView
            style="@style/Label"
            android:text="Frase" />

        <EditText
            android:id="@+id/etPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="90" />

        <TextView
            style="@style/Label"
            android:text="Stile" />

        <RadioGroup
            android:id="@+id/rgTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto" />

            <RadioButton
                android:id="@+id/rbColore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Colore" />

            <RadioButton
                android:id="@+id/rbChiaro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Chiaro" />
        </RadioGroup>

        <TextView
            style="@style/Label"
            android:text="Colore" />

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            style="@style/Label"
            android:text="Immagine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scegli immagine"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnImageClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Rimuovi"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvImageState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Label"
            android:text="Musica del widget" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scegli brano"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnAudioClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Rimuovi"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAudioState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Label"
            android:text="Nome mostrato nella notifica" />

        <EditText
            android:id="@+id/etAudioName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="40" />

        <TextView
            style="@style/Label"
            android:text="Volume" />

        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <CheckBox
            android:id="@+id/cbLoop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ripeti in loop" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Salva"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
